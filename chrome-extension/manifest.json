{
  "manifest_version": 3,
  "name": "Codeeve - Video & Audio Downloader",
  "short_name": "Codeeve - Download mp3/4",
  "version": "1.0.0",
  "description": "Universal Video & Audio Downloader supporting YouTube, TikTok, Instagram, Twitter/X and 1,800+ platforms.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://video.codeeve.com/*"
      ],
      "js": [
        "content-inject.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download Media",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}